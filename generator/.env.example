# OpenAI APIキー(Gitに含めないこと)
OPENAI_API_KEY=

# 物の判定に使うテキスト用モデル(画像入力に対応したモデル)
TEXT_MODEL=

# モンスター画像の生成に使う画像生成モデル
IMAGE_MODEL=

# 画像の画質設定(low / medium / high)
IMAGE_QUALITY=medium

# 画像生成の途中の絵の枚数(0〜3)。0 で使わない
# たまごのテーマ(fantasy)で、殻の内側にぼんやり透かして見せる(ほかのテーマとスマホには出さない)
# ※ 1枚ごとに画像出力トークンが100増える(公式)。2枚で1回 約0.9円
IMAGE_PARTIAL_IMAGES=2

# 画像のサイズ(幅x高さ)。幅・高さとも16の倍数にすること
# 既定は4:3の 1024x768(カードの絵柄の枠とゲーム内画像の両方で使う想定)
IMAGE_SIZE=1024x768

# OpenAI APIのタイムアウト(秒)。判定などに使う
# ※ 判定は実測 約8〜16秒で、ばらつきで30秒を超えることがあったため60秒にしている
API_TIMEOUT_SECONDS=60

# 画像生成のタイムアウト(秒)
# ※ 画像生成は30秒を超えることがある(gpt-image-2 / medium / 1024x1024 で実測 約35秒)ため、
#   判定とは別のタイムアウトにしている
IMAGE_TIMEOUT_SECONDS=120

# からうちモード。true にすると OpenAI API を一切呼ばず、
# 決まった判定結果とダミー画像を返す(料金0円)。
# 画面やスマホ接続の確認など、絵の中身が関係ない作業はこれを true にする
DRY_RUN=false

# 人が写った写真も生成するかどうか(面白枠)。
# true にすると、人が写っていても撮り直しにせず、
# 顔立ち・髪型・服の色などを取り込んだモンスターを作る。
# ※ 撮られる本人(と保護者)の同意が取れている場合だけ true にすること。
# ※ 通りすがりの他人が写り込むおそれがあるため、展示本番は false に戻すのが安全。
# ※ OpenAIの画像モデルは実在の人物の扱いに制限があり、
#   コンテンツフィルターで拒否されることがある(その場合はエラーをそのまま表示する)。
ALLOW_PERSON=false

# 融合の型(物を、モンスターのどこに・どう取り込むか)
#   空:毎回ランダムに選ぶ(同じ物でもモンスターに個性が出る)
#   weapon(武器)/ body(体の部位)/ armor(よろい):その型に固定する(比べるとき用)
# ※ 選ばれた型は outputs/.../result.json の monster.design_plan.fusion_type に残る
FUSION_TYPE=

# 画像プロンプトの書き方
#   detailed:設計図(融合の型・演出など)つきの詳しいプロンプト
#   simple  :OpenAI 公式サイトの Playground で試したのと同じ、短いプロンプト
# ※ どちらで作ったかは、PC画面の「使った設定」と result.json の settings.image_prompt_style に残る
IMAGE_PROMPT_STYLE=detailed

# 物を取り込む場所のパターン(短いプロンプト IMAGE_PROMPT_STYLE=simple のときに使う)
#   空:その動物で使うパターンから毎回ランダムに選ぶ(app/prompts.py の ANIMAL_FUSION_PARTS)
#   jaw(あご)/ tail(しっぽ)/ back(背中・翼)/ head(頭・角)/ arm(腕武器)/ armor(鎧)/ silhouette(シルエット):
#   そのパターンに固定する(パターンごとに崩れないか確かめるとき用)
# ※ 選ばれたパターンは、PC画面の「取り込む場所」と result.json の monster.design_plan.fusion_part に残る
FUSION_PART=

# 取り込み方(短いプロンプト IMAGE_PROMPT_STYLE=simple のときに使う)
#   空:武器(weapon)と体の部位(body)を半分ずつ選ぶ
#   weapon:物のいちばん目立つパーツを武器にする(前足のある動物は前足。ないと翼・しっぽ・鼻など。app/prompts.py の WEAPON_PARTS)
#   body:今までどおり、取り込む場所をランダムに選ぶ(FUSION_PART で固定もできる)
#   どちらも、物の2番目のパーツは、離れた部位の飾りにする
FUSION_STYLE=

# 背景の場所(短いプロンプト IMAGE_PROMPT_STYLE=simple のときに使う)
#   空:その動物のすみかから毎回ランダムに選ぶ(app/prompts.py の BACKGROUND_PLACES)
#   場所の言葉(例:森):その場所に固定する(比べるとき用)。時間帯・天気は、固定しても毎回ランダム
# ※ 選ばれた背景は、PC画面の「背景」と result.json の monster.design_plan(staging.scene・background_place)に残る
BACKGROUND=

# PC用ページ(展示の大画面)のテーマ。static/themes/ にあるフォルダの名前を書く
#   fusion(たんじょうのもり)だけ。ほかのテーマは archive/20261102_before_fusion_only/themes/ に控えてある
#   ブラウザで /?theme=fusion のように付けると、ここの設定より優先される
PC_THEME=fusion

# サーバーを起動したとき(python -m app.main)に、PC用ページをキオスクモード(全画面・アドレスバーなし)で開くか
#   true:開く(既定)/ false:開かない(自分でブラウザを開く)
#   キオスクモードを終わるときは Alt + F4(ブラウザを閉じるとサーバーも止まる)
KIOSK_MODE=true
# キオスクモードで使うブラウザ。空なら Edge → Chrome の順に探す
KIOSK_BROWSER=
# カードの「いんさつ」で、印刷のダイアログを出さずに既定のプリンターで刷るか(キオスクモードのときだけ)
#   false:ダイアログを出す(既定。プレビューで寸法を確かめられる)/ true:すぐ刷る(展示用)
#   用紙の大きさ・フチなしは、Windows のプリンターの設定で先に決めておく
KIOSK_PRINTING=false

# サーバーのポート番号
PORT=8000
